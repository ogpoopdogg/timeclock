{
  "rules": {
    "timeclock": {
      ".read": "auth != null && (auth.token.email.toLowerCase() === 'justin@ec.com' || auth.token.email.toLowerCase() === 'desirae@ec.com' || auth.token.email.toLowerCase() === 'celeste@ec.com')",
      ".write": "auth != null && (auth.token.email.toLowerCase() === 'justin@ec.com' || auth.token.email.toLowerCase() === 'desirae@ec.com' || auth.token.email.toLowerCase() === 'celeste@ec.com')",

      "settings": {
        ".read": "auth != null"
      },

      "employees": {
        "$ek": {
          ".read": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek"
        }
      },

      "shifts": {
        "$ek": {
          ".indexOn": ["in"],
          ".read": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek",
          "$shiftId": {
            ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && !data.exists() && root.child('timeclock/employees').child($ek).exists() && root.child('timeclock/employees').child($ek).child('active').val() !== false && root.child('timeclock/employees').child($ek).child('removed').val() !== true && newData.child('in').val() <= now && newData.child('in').val() > now - 60000 && !newData.child('out').exists() && !newData.child('edited').exists() && !newData.child('vehicleId').exists() && !newData.child('inLoc').exists() && !newData.child('inAddr').exists() && !newData.child('vans').exists() && !newData.child('swapHint').exists() && !newData.child('shop').exists() && (!newData.child('src').exists() || newData.child('src').val() === 'clock') && (!root.child('timeclock/open').child($ek).exists() || !root.child('timeclock/shifts').child($ek).child(root.child('timeclock/open').child($ek).val() + '').child('in').exists() || root.child('timeclock/shifts').child($ek).child(root.child('timeclock/open').child($ek).val() + '').child('out').exists()) && newData.parent().parent().parent().child('open').child($ek).val() === $shiftId && (!newData.child('tap').exists() || (newData.child('tap').val() <= now + 60000 && newData.child('tap').val() > now - 604800000))",
            "tap": { ".validate": "newData.isNumber()" },
            "out": {
              ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && data.parent().exists() && !data.exists() && newData.val() <= now && newData.val() > now - 60000"
            },
            "vehicleId": {
              ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && data.parent().exists() && !data.parent().child('out').exists()"
            },
            "vehicleName": {
              ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && data.parent().exists() && !data.parent().child('out').exists()"
            },
            "nickname": {
              ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && data.parent().exists() && !data.parent().child('out').exists()"
            },
            "shop": {
              ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && data.parent().exists() && !data.parent().child('out').exists()",
              ".validate": "newData.val() === true"
            },
            "outTap": {
              ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && !data.exists() && data.parent().child('out').val() > now - 300000 && newData.val() <= now + 60000 && newData.val() > now - 604800000",
              ".validate": "newData.isNumber()"
            },
            "oil": {
              ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && data.parent().child('in').exists() && (!data.child('done').exists() || data.child('done').val() === false) && (!data.parent().child('out').exists() || data.parent().child('out').val() > now - 86400000) && newData.child('at').val() <= now + 60000 && newData.child('at').val() > now - 604800000 && !newData.child('seenBy').exists() && !newData.child('seenAt').exists() && (!newData.child('due').exists() || !data.child('done').exists())",
              ".validate": "newData.hasChildren(['done', 'at']) || newData.hasChildren(['seenBy']) || newData.hasChildren(['due', 'at'])",
              "done": { ".validate": "newData.isBoolean()" },
              "due": { ".validate": "newData.isBoolean() && !newData.parent().child('done').exists()" },
              "at": { ".validate": "newData.isNumber()" },
              "how": { ".validate": "newData.val() === 'box' || newData.val() === 'out'" },
              "seenBy": { ".validate": "newData.isString() && newData.val().length <= 100" },
              "seenAt": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },
            "swapHint": {
              ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && data.parent().exists() && !newData.exists()"
            },
            "inLoc": {
              ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && !data.exists() && data.parent().child('in').val() > now - 300000",
              ".validate": "newData.hasChildren(['lat', 'lng']) || newData.hasChildren(['err'])",
              "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
              "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
              "acc": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "at": { ".validate": "newData.isNumber()" },
              "err": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "$other": { ".validate": false }
            },
            "outLoc": {
              ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && !data.exists() && data.parent().child('out').val() > now - 300000",
              ".validate": "newData.hasChildren(['lat', 'lng']) || newData.hasChildren(['err'])",
              "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
              "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
              "acc": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "at": { ".validate": "newData.isNumber()" },
              "err": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "$other": { ".validate": false }
            },
            "vans": {
              "$vid": {
                ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && !data.exists() && data.parent().parent().child('in').exists() && !data.parent().parent().child('out').exists() && newData.child('at').val() <= now && newData.child('at').val() > now - 60000 && ((newData.child('vehicleId').isString() && newData.child('vehicleName').isString() && (newData.child('how').val() === 'pick' || newData.child('how').val() === 'swap')) || (newData.child('how').val() === 'shop' && !newData.child('vehicleId').exists() && !newData.child('vehicleName').exists()))",
                ".validate": "newData.hasChildren(['at', 'how'])",
                "at": { ".validate": "newData.isNumber()" },
                "vehicleId": { ".validate": "newData.isString() && newData.val().length <= 128" },
                "vehicleName": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "how": { ".validate": "newData.val() === 'pick' || newData.val() === 'swap' || newData.val() === 'taken' || newData.val() === 'shop' || newData.val() === 'admin'" },
                "by": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "takenId": { ".validate": "newData.isString() && newData.val().length <= 128" },
                "takenName": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "addr": { ".validate": "newData.isString() && newData.val().length <= 300" },
                "addrErr": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "loc": {
                  ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && !data.exists() && data.parent().child('at').val() > now - 300000",
                  ".validate": "newData.hasChildren(['lat', 'lng']) || newData.hasChildren(['err'])",
                  "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
                  "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
                  "acc": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                  "at": { ".validate": "newData.isNumber()" },
                  "err": { ".validate": "newData.isString() && newData.val().length <= 20" },
                  "$other": { ".validate": false }
                },
                "$other": { ".validate": false }
              }
            }
          }
        }
      },

      "push_tokens": {
        "$ek": {
          ".read": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek",
          "$key": {
            ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && root.child('timeclock/employees').child($ek).exists()",
            ".validate": "newData.child('token').isString() && newData.child('token').val().length < 4096"
          }
        }
      },

      "push_tests": {
        "$ek": {
          ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && root.child('timeclock/employees').child($ek).child('active').val() !== false && root.child('timeclock/employees').child($ek).exists()"
        }
      },

      "prefs": {
        "$ek": {
          ".read": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek",
          ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && root.child('timeclock/employees').child($ek).exists()",
          "punchReminder": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      },

      "open": {
        "$ek": {
          ".read": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek",
          ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && root.child('timeclock/employees').child($ek).exists() && root.child('timeclock/employees').child($ek).child('active').val() !== false && root.child('timeclock/employees').child($ek).child('removed').val() !== true && newData.isString() && newData.parent().parent().child('shifts').child($ek).child(newData.val()).child('in').exists() && !newData.parent().parent().child('shifts').child($ek).child(newData.val()).child('out').exists() && (!root.child('timeclock/open').child($ek).exists() || !root.child('timeclock/shifts').child($ek).child(root.child('timeclock/open').child($ek).val() + '').child('in').exists() || root.child('timeclock/shifts').child($ek).child(root.child('timeclock/open').child($ek).val() + '').child('out').exists())"
        }
      },

      "requests": {
        "$ek": {
          ".read": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek",
          "$id": {
            ".write": "auth != null && auth.token.email.toLowerCase().replace('.', ',') === $ek && ((!data.exists() && root.child('timeclock/employees').child($ek).exists() && root.child('timeclock/employees').child($ek).child('active').val() !== false && root.child('timeclock/employees').child($ek).child('removed').val() !== true && newData.child('status').val() === 'open' && !newData.child('reply').exists() && !newData.child('by').exists() && !newData.child('doneAt').exists()) || (!newData.exists() && data.child('status').val() === 'open'))",
            ".validate": "newData.hasChildren(['at', 'kind', 'day', 'status'])",
            "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "kind": { ".validate": "newData.val() === 'in' || newData.val() === 'out' || newData.val() === 'both' || newData.val() === 'wrong' || newData.val() === 'other'" },
            "day": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
            "inTime": { ".validate": "newData.isString() && newData.val().matches(/^\\d{2}:\\d{2}$/)" },
            "outTime": { ".validate": "newData.isString() && newData.val().matches(/^\\d{2}:\\d{2}$/)" },
            "shiftId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "status": { ".validate": "newData.val() === 'open' || newData.val() === 'done' || newData.val() === 'declined'" },
            "reply": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "doneAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      },

      "van_reports": {
        "$id": {
          ".write": "auth != null && !data.exists() && newData.child('ek').val() === auth.token.email.toLowerCase().replace('.', ',') && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).child('active').val() !== false && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).child('removed').val() !== true && newData.child('status').val() === 'open' && !newData.child('fixNote').exists() && !newData.child('by').exists() && !newData.child('doneAt').exists()",
          ".validate": "newData.hasChildren(['at', 'ek', 'vehicleId', 'text', 'status'])",
          "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "ek": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "vehicleId": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "vehicleName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "shiftId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000" },
          "status": { ".validate": "newData.val() === 'open' || newData.val() === 'fixed'" },
          "fixNote": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "by": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "doneAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },

      "audit": {
        ".indexOn": ["ek"]
      },

      "vans": {
        ".read": "auth != null && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
        "$vanId": {
          ".validate": "$vanId.beginsWith('van_') && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40"
        }
      },

      "oil_plan": {
        ".read": "auth != null && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
        "def": {
          ".validate": "newData.hasChildren(['mode'])",
          "mode": { ".validate": "newData.val() === 'shift' || newData.val() === 'every' || newData.val() === 'days' || newData.val() === 'never'" },
          "every": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60 && newData.parent().child('mode').val() === 'every'" },
          "days": {
            ".validate": "newData.parent().child('mode').val() === 'days'",
            "$day": { ".validate": "$day.matches(/^(sun|mon|tue|wed|thu|fri|sat)$/) && newData.val() === true" }
          },
          "$other": { ".validate": false }
        },
        "vehicles": {
          "$key": {
            ".validate": "$key.matches(/^[a-z0-9]{1,60}$/) && newData.hasChildren(['mode'])",
            "mode": { ".validate": "newData.val() === 'shift' || newData.val() === 'every' || newData.val() === 'days' || newData.val() === 'never'" },
            "every": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60 && newData.parent().child('mode').val() === 'every'" },
            "days": {
              ".validate": "newData.parent().child('mode').val() === 'days'",
              "$day": { ".validate": "$day.matches(/^(sun|mon|tue|wed|thu|fri|sat)$/) && newData.val() === true" }
            },
            "$other": { ".validate": false }
          }
        },
        "ask": {
          "$key": { ".validate": "$key.matches(/^[a-z0-9]{1,60}$/) && newData.isNumber()" }
        },
        "$other": { ".validate": false }
      },

      "oil_last": {
        ".read": "auth != null && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
        "$key": {
          ".write": "auth != null && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).child('active').val() !== false && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).child('removed').val() !== true && newData.child('ek').val() === auth.token.email.toLowerCase().replace('.', ',') && newData.child('shiftId').isString() && root.child('timeclock/shifts').child(auth.token.email.toLowerCase().replace('.', ',')).child(newData.child('shiftId').val() + '').child('oil').child('done').val() === true && newData.child('at').val() === root.child('timeclock/shifts').child(auth.token.email.toLowerCase().replace('.', ',')).child(newData.child('shiftId').val() + '').child('oil').child('at').val() && (!data.exists() || newData.child('at').val() >= data.child('at').val())",
          ".validate": "$key.matches(/^[a-z0-9]{1,60}$/) && newData.hasChildren(['at', 'ek', 'shiftId'])",
          "at": { ".validate": "newData.isNumber()" },
          "ek": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "shiftId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "by": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "vehicleName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "$other": { ".validate": false }
        }
      },

      "vehicle_claims": {
        ".read": "auth != null && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
        "$gpsId": {
          ".write": "auth != null && ((newData.exists() && newData.child('ek').val() === auth.token.email.toLowerCase().replace('.', ',') && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).child('active').val() !== false && newData.child('shiftId').isString() && root.child('timeclock/shifts').child(auth.token.email.toLowerCase().replace('.', ',')).child(newData.child('shiftId').val()).child('in').exists() && !root.child('timeclock/shifts').child(auth.token.email.toLowerCase().replace('.', ',')).child(newData.child('shiftId').val()).child('out').exists()) || (!newData.exists() && data.child('ek').val() === auth.token.email.toLowerCase().replace('.', ',')))"
        }
      }
    },

    "developer": {
      "dispatch_dashboard": {
        "drivers": {
          ".read": "auth != null && ((auth.token.email.toLowerCase() === 'justin@ec.com' || auth.token.email.toLowerCase() === 'desirae@ec.com' || auth.token.email.toLowerCase() === 'celeste@ec.com') || root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).exists())"
        },
        "driver_nicknames": {
          ".read": "auth != null && ((auth.token.email.toLowerCase() === 'justin@ec.com' || auth.token.email.toLowerCase() === 'desirae@ec.com' || auth.token.email.toLowerCase() === 'celeste@ec.com') || root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).exists())",
          "$gpsId": {
            ".write": "auth != null && ((auth.token.email.toLowerCase() === 'justin@ec.com' || auth.token.email.toLowerCase() === 'desirae@ec.com' || auth.token.email.toLowerCase() === 'celeste@ec.com') || (root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && root.child('timeclock/employees').child(auth.token.email.toLowerCase().replace('.', ',')).child('active').val() !== false)) && (!newData.exists() || (newData.isString() && newData.val().length <= 24))"
          }
        }
      }
    }
  }
}
