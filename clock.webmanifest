{
    "id": "/timeclock/",
    "name": "E&C Courier Time Clock",
    "short_name": "E&C Clock",
    "description": "Punch in and out, and pick your vehicle for the day.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#0c0e10",
    "theme_color": "#0c0e10",
    "icons": [
        {
            "src": "icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "related_applications": [
        {
            "platform": "webapp",
            "url": "https://app.eandccourier.ca/timeclock/clock.webmanifest"
        }
    ],
    "prefer_related_applications": false
}
